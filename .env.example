# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GOOGLE_BOOKS_KEY: Required for Google Books API queries.
GOOGLE_BOOKS_KEY=MY_GOOGLE_BOOKS_KEY

# ── Production configuration requirements ────────────────────────────────────
# The values below are REQUIRED for production. They are deliberately left
# commented out so that the build produces an EMPTY BuildConfig field, which the
# app treats as "not configured" and fails closed on. Uncomment and supply a real
# value in your untracked `.env` (already git-ignored) or as a Gradle property.
# Do NOT commit real values.
#
# SUPABASE_URL: Supabase project URL, e.g. https://<project-ref>.supabase.co
# SUPABASE_URL=
# SUPABASE_ANON_KEY: Supabase "anon" / publishable key. Leave empty until a real
#   project exists; the app will not fabricate one.
# SUPABASE_ANON_KEY=
# SUPABASE_BUCKET: Storage bucket that holds ARC manuscripts.
# SUPABASE_BUCKET=arc-manuscripts
#
# GOOGLE_WEB_CLIENT_ID: OAuth 2.0 *web* client ID (NOT the Android client ID)
#   from Google Cloud Console, used as server_client_id for Google Sign-In.
# GOOGLE_WEB_CLIENT_ID=


# RECAPTCHA_SITE_KEY: Firebase App Check reCAPTCHA v3 site key.
# Left empty so the build still produces a working APK: App Check is skipped
# rather than installed with a broken key, and Firebase Auth plus the Firestore
# security rules continue to apply. Set it in your untracked `.env` or as a
# Gradle property to enable app attestation in release builds.
# Debug builds use the App Check debug provider and do not read this value.
# RECAPTCHA_SITE_KEY=
