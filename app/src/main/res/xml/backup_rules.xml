<?xml version="1.0" encoding="utf-8"?><!--
   Full backup rules for devices older than API 31.
   See https://developer.android.com/guide/topics/data/autobackup
   Ignored for devices running API 31+, which use data_extraction_rules.xml.

   Kept in sync with data_extraction_rules.xml: the Room database (bookmark
   wallet, redemption requests, reading progress) and the Firebase Auth session
   (shared preferences) are excluded from backup.
-->
<full-backup-content>
    <exclude domain="database" />
    <exclude domain="sharedpref" />
</full-backup-content>
